<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student List</title>
</head>

<!-- <%= %>
    <%- %>
        <% %> -->

<body>
    <h1>Student List</h1>

    <table border="1" width="100%">
        <% if (students.length> 0) { %>

            <tr>
                <th>NO.</th>
                <th>Name</th>
                <th>Email</th>
                <th>Password</th>
                <th>Action</th>
            </tr>

            <% for (let i=0; i < students.length; i++) { %>
                <tr>
                    <td><%- students[i].id %></td>
                    <td><%- students[i].name %></td>
                    <td><%- students[i].email %></td>
                    <td><%- students[i].password %></td>
                    <td><a href="delete-student?id=<%- students[i].id %>">Delete</a></td>
                </tr>
                <% } %>
                    <% } else { %>
                        <h1>STUDENT DATA NOT FOUND!!!</h1>
                        <% } %>
    </table>

</body>

</html>